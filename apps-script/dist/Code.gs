      manage_token_hash: U.tokenHash(token),
      duplicate_of: dup ? dup.id : '',
      category: C.CATEGORIES.indexOf(U.str(p.category)) >= 0 ? U.str(p.category) : 'Other',
      published_via: trusted ? 'trusted publisher' : 'review',
