      source_url: U.safeUrl(p.source_url),
      registration_url: U.safeUrl(p.registration_url),
      relevance: U.clip(p.relevance, 400),
      cost: U.clip(p.cost, 120),
      accessibility: U.clip(p.accessibility, 400),
