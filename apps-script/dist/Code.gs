  /* ---------------- people, consent, affiliations ---------------- */

  function recordConsent(store, ctx, personId, kind, value, subId) {
    store.insert('Consents', {
      id: U.makeId('con', ctx),
      person_id: personId,
      kind: kind,
      value: U.yn(value),
      text_shown: C.CONSENT_TEXT[kind] || kind,
      source_submission_id: subId,
      recorded_at: U.nowIso(ctx)
